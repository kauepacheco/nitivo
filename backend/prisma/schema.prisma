generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  OWNER
  EMPLOYEE
}

enum MembershipStatus {
  ACTIVE
  REVOKED
}

enum AccessTokenPurpose {
  SET_PASSWORD
  RESET_PASSWORD
}

model CarWash {
  id                          String               @id @default(cuid())
  name                        String
  slug                        String               @unique
  operationalContactPhone     String?
  timezone                    String               @default("America/Sao_Paulo")
  minimumBookingNoticeMinutes Int                  @default(60)
  bookingHorizonDays          Int                  @default(30)
  changeNoticeMinutes         Int                  @default(120)
  slotIntervalMinutes         Int                  @default(30)
  createdAt                   DateTime             @default(now()) @db.Timestamptz(3)
  memberships                 Membership[]
  services                    ServiceOffering[]
  employeeInvitations         EmployeeInvitation[]
  boxes                       Box[]
  customers                   Customer[]
  vehicles                    Vehicle[]
  weeklyHours                 WeeklyOpeningHour[]
}

model Box {
  id           String        @id @default(cuid())
  carWashId    String
  name         String
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  carWash      CarWash       @relation(fields: [carWashId], references: [id], onDelete: Restrict)
  appointments Appointment[]

  @@unique([id, carWashId])
  @@unique([carWashId, name])
  @@index([carWashId, active, createdAt])
}

enum AppointmentStatus {
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELED
  NO_SHOW
}

model Customer {
  id           String        @id @default(cuid())
  carWashId    String
  name         String
  phone        String
  carWash      CarWash       @relation(fields: [carWashId], references: [id], onDelete: Restrict)
  vehicles     Vehicle[]
  appointments Appointment[]

  @@unique([id, carWashId])
}

model Vehicle {
  id           String        @id @default(cuid())
  carWashId    String
  customerId   String
  plate        String
  carWash      CarWash       @relation(fields: [carWashId], references: [id], onDelete: Restrict)
  customer     Customer      @relation(fields: [customerId, carWashId], references: [id, carWashId], onDelete: Restrict)
  appointments Appointment[]

  @@unique([id, customerId, carWashId])
}

model Appointment {
  id                       String            @id @default(cuid())
  carWashId                String
  customerId               String?
  vehicleId                String?
  origin                   String            @default("LEGACY")
  attemptHash              String?
  requestHash              String?
  customer                 Customer?         @relation(fields: [customerId, carWashId], references: [id, carWashId], onDelete: Restrict)
  vehicle                  Vehicle?          @relation(fields: [vehicleId, customerId, carWashId], references: [id, customerId, carWashId], onDelete: Restrict)
  createdByMembershipId    String?
  createdBy                Membership?       @relation(fields: [createdByMembershipId, carWashId], references: [id, carWashId], onDelete: Restrict)
  boxId                    String
  serviceOfferingId        String
  startsAt                 DateTime          @db.Timestamptz(3)
  endsAt                   DateTime          @db.Timestamptz(3)
  serviceName              String
  servicePriceInCents      Int
  serviceDurationInMinutes Int
  status                   AppointmentStatus @default(CONFIRMED)
  statusChanges            AppointmentStatusChange[]
  createdAt                DateTime          @default(now()) @db.Timestamptz(3)
  box                      Box               @relation(fields: [boxId, carWashId], references: [id, carWashId], onDelete: Restrict)
  serviceOffering          ServiceOffering   @relation(fields: [serviceOfferingId, carWashId], references: [id, carWashId], onDelete: Restrict)

  @@unique([carWashId, attemptHash])
  @@unique([id, carWashId])
  @@index([carWashId, startsAt, endsAt])
  @@index([boxId, startsAt, endsAt])
  @@index([createdByMembershipId, carWashId])
}

model WeeklyOpeningHour {
  id             String  @id @default(cuid())
  carWashId      String
  weekday        Int
  opensAtMinute  Int
  closesAtMinute Int
  carWash        CarWash @relation(fields: [carWashId], references: [id], onDelete: Cascade)

  @@unique([carWashId, weekday])
  @@index([carWashId, weekday])
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  passwordHash        String?
  createdAt           DateTime             @default(now()) @db.Timestamptz(3)
  memberships         Membership[]
  accessTokens        AccessToken[]
  sessions            Session[]
  invitationsReceived EmployeeInvitation[] @relation("InvitationRecipient")
  invitationsSent     EmployeeInvitation[] @relation("InvitationSender")
}

model EmployeeInvitation {
  id              String    @id @default(cuid())
  carWashId       String
  email           String
  invitedUserId   String?
  invitedByUserId String
  tokenHash       String    @unique
  expiresAt       DateTime  @db.Timestamptz(3)
  consumedAt      DateTime? @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  carWash         CarWash   @relation(fields: [carWashId], references: [id], onDelete: Cascade)
  invitedUser     User?     @relation("InvitationRecipient", fields: [invitedUserId], references: [id], onDelete: Cascade)
  invitedByUser   User      @relation("InvitationSender", fields: [invitedByUserId], references: [id], onDelete: Cascade)

  @@index([carWashId, consumedAt, expiresAt])
  @@index([email, consumedAt])
}

model Membership {
  id                  String           @id @default(cuid())
  userId              String
  carWashId           String
  role                MembershipRole
  status              MembershipStatus @default(ACTIVE)
  createdAt           DateTime         @default(now()) @db.Timestamptz(3)
  user                User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  carWash             CarWash          @relation(fields: [carWashId], references: [id], onDelete: Cascade)
  appointmentsCreated Appointment[]
  appointmentStatusChanges AppointmentStatusChange[]

  @@unique([userId, carWashId])
  @@unique([id, carWashId])
  @@index([carWashId, status])
}

model AppointmentStatusChange {
  id                    String            @id @default(cuid())
  appointmentId         String
  carWashId             String
  previousStatus        AppointmentStatus
  status                AppointmentStatus
  changedByMembershipId String
  changedAt             DateTime          @default(now()) @db.Timestamptz(3)
  cancellationRequestedAt DateTime?       @db.Timestamptz(3)
  cancellationReason    String?
  appointment           Appointment       @relation(fields: [appointmentId, carWashId], references: [id, carWashId], onDelete: Restrict)
  changedBy             Membership        @relation(fields: [changedByMembershipId, carWashId], references: [id, carWashId], onDelete: Restrict)

  @@index([appointmentId, changedAt])
  @@index([carWashId, changedAt])
  @@index([changedByMembershipId, carWashId])
}

model AccessToken {
  id         String             @id @default(cuid())
  userId     String
  purpose    AccessTokenPurpose
  tokenHash  String             @unique
  expiresAt  DateTime           @db.Timestamptz(3)
  consumedAt DateTime?          @db.Timestamptz(3)
  createdAt  DateTime           @default(now()) @db.Timestamptz(3)
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

model Session {
  id                String    @id @default(cuid())
  userId            String
  tokenHash         String    @unique
  csrfToken         String
  expiresAt         DateTime  @db.Timestamptz(3)
  absoluteExpiresAt DateTime  @db.Timestamptz(3)
  lastSeenAt        DateTime  @default(now()) @db.Timestamptz(3)
  revokedAt         DateTime? @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
}

model AuthenticationThrottle {
  key             String    @id
  failedAttempts  Int       @default(0)
  windowStartedAt DateTime  @default(now()) @db.Timestamptz(3)
  blockedUntil    DateTime? @db.Timestamptz(3)
}

model ServiceOffering {
  id                String        @id @default(cuid())
  carWashId         String
  name              String
  priceInCents      Int
  durationInMinutes Int
  active            Boolean       @default(true)
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)
  carWash           CarWash       @relation(fields: [carWashId], references: [id], onDelete: Restrict)
  appointments      Appointment[]

  @@unique([id, carWashId])
  @@index([carWashId, createdAt])
}
